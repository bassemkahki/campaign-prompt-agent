{
  "name": "campaign-prompt-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for creative campaign ingestion and prompt generation",
  "main": "dist/mcp/server.js",
  "bin": {
    "campaign-agent": "dist/mcp/server.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && chmod +x dist/mcp/server.js",
    "install-agent": "node install.js",
    "start": "tsx src/mcp/server.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "keywords": [
    "mcp",
    "ai",
    "creative",
    "briefing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ai": "6.0.194",
    "commander": "15.0.0",
    "sharp": "0.33.5",
    "zod": "3.25.76",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.0.3"
  }
}
